# Copy to .env.local and fill in real values. .env* is already gitignored.

# Postgres connection string, e.g. from Neon (Vercel's managed Postgres
# integration). Neon's connection strings already include sslmode=require.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth. Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
